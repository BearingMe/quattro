# Build output — all generated artifacts must live here
build/
bin/
obj/
out/

# CMake user-local configuration
CMakeUserPresets.json

# Compiled artifacts that must never escape build/
*.obj
*.pdb
*.ilk
*.exp

# GPU captures and profiling output
*.rgp
*.v-cap

# IDE / editor
.vs/
.vscode/
.idea/
*.user

# Temporary files and logs
*.log
*.tmp

# Python (offline analysis scripts only)
__pycache__/
*.pyc

# OS
Thumbs.db
